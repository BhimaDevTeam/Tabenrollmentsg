<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS Application alias: /vrudhitabenrollmentsg
  Physical path: C:\inetpub\wwwroot\vrudhitabenrollmentsg\build
  Requires: URL Rewrite module
-->
<configuration>

    <!-- ==================================================================== -->
    <!--  COUNTRY / REGION SELECTION CONFIGURATION                            -->
    <!-- ==================================================================== -->
    <appSettings>
        <!-- ACTIVE REGION: SINGAPORE (SNG) -->
        <add key="SelectedCountry" value="Singapore" />
        <add key="CountryCode" value="SG" />
        <add key="Currency" value="SGD" />
        <add key="VrudhiPortalApiUrl" value="https://suvarnagopura.com/VrudhiPortalAPISG" />
        <add key="NewMemberApiUrl" value="https://suvarnagopura.com/VrudhiPortalAPISG/api/payment-gateway/newmember-creationTE" />

        <!-- ==================================================================== -->
        <!--  PAYMENT MODE CONFIGURATION (Online / Offline / Both)                -->
        <!-- ==================================================================== -->
        <!-- ACTIVE PAYMENT MODE: Offline -->
        <add key="PaymentMode" value="Offline" />
        <!--
        <add key="PaymentMode" value="Both" />
        <add key="PaymentMode" value="Online" />
        -->

        <!-- ==================================================================== -->
        <!--  E-KYC AND E-SIGN CONFIGURATION (1 = Enabled/Displayed, 0 = Disabled)-->
        <!-- ==================================================================== -->
        <!-- ACTIVE FEATURE FLAGS: 0 (Disabled) -->
        <add key="EnableEkyc" value="0" />
        <add key="EnableEsign" value="0" />

        <!-- ==================================================================== -->
        <!--  SIGNATURE EMAIL CONFIGURATION                                        -->
        <!-- ==================================================================== -->
        <add key="EnableSignatureEmail" value="0" />
    </appSettings>

    <system.webServer>
        <directoryBrowse enabled="false" />
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>
        <staticContent>
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>
        <httpProtocol>
            <customHeaders>
                <!-- HTTP Header for Active Region: Singapore -->
                <add name="X-App-Country" value="Singapore" />
                <add name="X-App-Country-Code" value="SG" />
                
                <!-- HTTP Header for Active Payment Mode (Both / Offline / Online) -->
                <add name="X-App-Payment-Mode" value="Offline" />
                
                <!-- HTTP Headers for Active Feature Flags (0 = Disabled, 1 = Enabled) -->
                <add name="X-App-Enable-Ekyc" value="0" />
                <add name="X-App-Enable-Esign" value="0" />
                <!-- Signature email on Save: 0 = Disabled, 1 = Enabled -->
                <add name="X-App-Enable-Signature-Email" value="0" />
            </customHeaders>
        </httpProtocol>
        <rewrite>
            <rules>
                <!-- ============================================================ -->
                <!-- CRM Proxy: forwards /crm-proxy/* → bgstaging.bhima.gold/crm  -->
                <!-- Bypasses browser CORS checks (server-to-server request)       -->
                <!-- ============================================================ -->
                <rule name="CRM Proxy" stopProcessing="true">
                    <match url="^vrudhitabenrollmentsg/crm-proxy/(.*)" />
                    <action type="Rewrite" url="https://bgstaging.bhima.gold/crm/{R:1}" />
                    <serverVariables>
                        <set name="HTTP_X_ORIGINAL_ACCEPT_ENCODING" value="{HTTP_ACCEPT_ENCODING}" />
                        <set name="HTTP_ACCEPT_ENCODING" value="" />
                    </serverVariables>
                </rule>
                <rule name="React SPA" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_URI}" pattern="^/vrudhitabenrollmentsg/tabqrgen" negate="true" />
                        <add input="{REQUEST_URI}" pattern="^/vrudhitabenrollmentsg/crm-proxy" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="/vrudhitabenrollmentsg/index.html" />
                </rule>
            </rules>
        </rewrite>
        <httpErrors existingResponse="PassThrough" />
    </system.webServer>
</configuration>
